# API key de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de Gemini a usar en los nodos del grafo
GEMINI_MODEL=gemini-flash-latest

# Rutas de las credenciales OAuth de Gmail (ver README para cómo generarlas)
GMAIL_CREDENTIALS_PATH=secrets/credentials.json
GMAIL_TOKEN_PATH=secrets/token.json

# Ruta del checkpoint de LangGraph (persistencia entre corridas)
CHECKPOINT_DB_PATH=data/checkpoints.sqlite
